# Dirty Pipe case.env (Option A — vulnerable pin)

# Populated when /opt/atlas/livepatch-corpus/linux-dirtypipe is ready
PILOT_ID=LP-CORPUS-DIRTYPIPE
KERNEL_REPO=https://git.kernel.org/pub/scm/linux/kernel/git/stable/linux.git
KERNEL_TAG=v5.16.10
# KERNEL_COMMIT filled after clone: git -C linux-dirtypipe rev-parse HEAD
WORK_ROOT_HINT=/opt/atlas/livepatch-corpus
LINUX_DIR_HINT=/opt/atlas/livepatch-corpus/linux-dirtypipe
FIX_TAG=v5.16.11
CVE=CVE-2022-0847
MARKER=DIRTYPIPE-HARNESS-MARK
PROC_FILE=/proc/version
