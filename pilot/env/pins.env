# Pilot environment pins — LP-PILOT-01
# Reproducibility record (update hashes after first successful build)

PILOT_ID=LP-PILOT-01-cmdline
KERNEL_REPO=https://git.kernel.org/pub/scm/linux/kernel/git/stable/linux.git
KERNEL_TAG=v6.6.47
KERNEL_COMMIT=4c1a2d4cd9a5b6c55739a80c5b9efbca322adad7

GCC_PACKAGE=gcc-13
GCC_VERSION=13.3.0
BINUTILS_VERSION=2.42

# Pilot case: replicate in-tree livepatch-sample target (cmdline_proc_show)
# Citable: samples/livepatch/livepatch-sample.c @ KERNEL_TAG
PATCH_SOURCE=kernel-sample-livepatch-cmdline
PATCH_REFERENCE=Documentation/livepatch/livepatch-sample.rst

CONFIG_FRAG=pilot/config/livepatch.fragment

BUILD_JOBS=8
# Set at runtime, e.g. export WORK_ROOT=$HOME/livepatch-pilot
