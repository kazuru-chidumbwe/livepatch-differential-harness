# Python
.venv/
__pycache__/
*.pyc
.pytest_cache/

# Run output
logs/
*.log
# package corpus forensic packs (keep transcripts / build logs)
!pilot/results/**/*.log

# Built modules and VM artifacts
build/
*.ko
!pilot/results/**/*.ko
*.qcow2
*.img

# Handbuild out-of-tree module debris (absolute lab paths; regenerable)
pilot/handbuild/**/*.o
pilot/handbuild/**/*.mod
pilot/handbuild/**/*.mod.c
pilot/handbuild/**/*.cmd
pilot/handbuild/**/*.d
pilot/handbuild/**/modules.order
pilot/handbuild/**/Module.symvers
pilot/handbuild/**/.tmp_versions/

# PRE population stub build debris (keep sources + summary + .ko)
pilot/results/LP-PRE-POPULATION/stubs/**/*.o
pilot/results/LP-PRE-POPULATION/stubs/**/*.mod
pilot/results/LP-PRE-POPULATION/stubs/**/*.mod.c
pilot/results/LP-PRE-POPULATION/stubs/**/*.cmd
pilot/results/LP-PRE-POPULATION/stubs/**/*.d
pilot/results/LP-PRE-POPULATION/stubs/**/modules.order
pilot/results/LP-PRE-POPULATION/stubs/**/Module.symvers
pilot/results/LP-PRE-POPULATION/stubs/**/.tmp_versions/

# Published artifact pointers (generated by make reproduce)
artifacts/*
!artifacts/.gitkeep

# Vendor / kernel trees (cloned by scripts/bootstrap-env.sh)
../_vendor/
_vendor/

# IDE / OS
.idea/
.vscode/
.DS_Store
Thumbs.db
